# ==============================================================================
# Moh-AI Tech - Environment Configuration Template
# COPY THIS FILE TO .env.local OR .env BEFORE STARTING THE APPLICATION
# NEVER COMMIT ACTUAL SECRETS OR CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NODE_ENV="development"

# Database Configuration (PostgreSQL / Supabase / Neon / Local SQLite)
# Example for PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/mohai_tech?schema=public"
DIRECT_URL="postgresql://postgres:your_db_password@localhost:5432/mohai_tech?schema=public"

# NextAuth Authentication Security
# Generate a strong 32+ character random secret using: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-32-character-random-secret"
NEXTAUTH_URL="http://localhost:9002"

# Transactional Email Providers
# Primary: Resend API (https://resend.com)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
RESEND_FROM_EMAIL="Moh-AI Tech <info@moh-ai-tech.com>"

# Secondary / Fallback: SMTP Configuration
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_USER="info@moh-ai-tech.com"
SMTP_PASS="your_secure_smtp_password"

# Internal Lead Notification Recipients (comma-separated list)
NOTIFICATION_EMAIL="info@moh-ai-tech.com, mohaitechpvt@gmail.com"

# HubSpot CRM Integration (Private App Access Token)
HUBSPOT_ACCESS_TOKEN="pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Webhook Notifications (Optional - e.g. CallMeBot WhatsApp Webhook)
WHATSAPP_WEBHOOK_URL="https://api.callmebot.com/whatsapp.php?phone=919999999999&text=hello&apikey=123456"

# Frontend Public Analytics (Google Analytics 4 Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Backend FastAPI Microservice Security (if running Python backend)
SECRET_KEY="replace-with-fastapi-secure-32-char-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
